<mxfile host="app.diagrams.net" pages="3">
  <diagram id="M1_BKRpKQZOK5PTqv07Q" name="Page-2">
    <mxGraphModel dx="19520" dy="12240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% =========================================================================\n    %% 1. CORE USER DOMAIN &amp; ROLE-BASED ACCESS CONTROL (RBAC)\n    %% =========================================================================\n    class User {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String fullName\n        -String email\n        -String password\n        -UserRole role\n        -LocalDateTime createdAt\n        +register(req: RegisterRequest) User\n        +login(req: LoginRequest) AuthResponse\n        +updateProfile(name: String, email: String) void\n        +resetPassword(newPassword: String) boolean\n    }\n\n    class UserRole {\n        &lt;&lt;Enumeration&gt;&gt;\n        ADMINISTRATOR\n        CUSTOMER\n        EVENT_MANAGER\n        INVENTORY_STAFF\n        VENDOR\n        GUEST\n    }\n\n    class Customer {\n        &lt;&lt;Role-Entity&gt;&gt;\n        -String contactNumber\n        -String billingAddress\n        +createEvent(req: EventRequest) Event\n        +requestBooking(venueOrServiceId: Long) Booking\n        +submitPayment(bookingId: Long, amt: Double) Payment\n        +submitReview(serviceId: Long, rating: int) Review\n    }\n\n    class EventManager {\n        &lt;&lt;Role-Entity&gt;&gt;\n        -String department\n        -String assignedZone\n        +reviewEvent(eventId: Long, status: EventStatus) void\n        +buildMasterTimeline(eventId: Long) Schedule\n        +assignTask(taskId: Long, staffId: Long) void\n        +verifyEquipmentAllocation(allocationId: Long) boolean\n    }\n\n    class VendorProfile {\n        &lt;&lt;Role-Entity&gt;&gt;\n        -String businessName\n        -String serviceCategory\n        -String contactPhone\n        -Double baseRate\n        +updateAvailability(slot: LocalDateTime, status: String) void\n        +acceptBooking(bookingId: Long) void\n        +rejectBooking(bookingId: Long, reason: String) void\n        +launchPromotion(promoForm: PromotionForm) Promotion\n    }\n\n    class InventoryStaff {\n        &lt;&lt;Role-Entity&gt;&gt;\n        -String staffCode\n        -String warehouseSection\n        +addNewItem(req: CreateItemRequest) InventoryItem\n        +adjustQuantity(sku: String, delta: int) void\n        +allocateGear(eventId: Long, sku: String, qty: int) void\n        +logReturnedEquipment(allocationId: Long, cond: String) void\n    }\n\n    class Guest {\n        &lt;&lt;Role-Entity&gt;&gt;\n        -String ticketNumber\n        -String dietaryPreferences\n        +confirmAttendance(eventId: Long) void\n        +viewPublicSchedule(eventId: Long) Schedule\n        +submitInquiry(message: String) Inquiry\n    }\n\n    class Administrator {\n        &lt;&lt;Role-Entity&gt;&gt;\n        -String adminLevel\n        +manageUserAccount(userId: Long, role: UserRole) void\n        +generateSystemAuditReport() Report\n        +viewSystemLogs() List~String~\n    }\n\n    %% Inheritance / Role Relationships\n    User &lt;|-- Customer : specializes\n    User &lt;|-- EventManager : specializes\n    User &lt;|-- VendorProfile : specializes\n    User &lt;|-- InventoryStaff : specializes\n    User &lt;|-- Guest : specializes\n    User &lt;|-- Administrator : specializes\n    User --&gt; UserRole : typed by\n\n    %% =========================================================================\n    %% 2. FR2: EVENT CREATION &amp; LIFECYCLE MANAGEMENT\n    %% =========================================================================\n    class Event {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String title\n        -String description\n        -String eventType\n        -LocalDate eventDate\n        -String venue\n        -Integer expectedGuests\n        -EventStatus status\n        -LocalDateTime createdAt\n        +updateDetails(title: String, desc: String, guests: int) void\n        +changeStatus(newStatus: EventStatus) void\n        +cancelEvent(reason: String) void\n        +getAuditHistory() List~String~\n    }\n\n    class EventStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        DRAFT\n        PENDING_APPROVAL\n        APPROVED\n        IN_PROGRESS\n        COMPLETED\n        CANCELLED\n    }\n\n    Event --&gt; EventStatus : holds\n    Customer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Event : organizes\n\n    %% =========================================================================\n    %% 3. FR3: VENUE &amp; VENDOR BOOKING MANAGEMENT\n    %% =========================================================================\n    class Booking {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -LocalDate bookingDate\n        -Double totalCost\n        -BookingStatus status\n        -PaymentStatus paymentStatus\n        -LocalDateTime createdAt\n        +confirmBooking() void\n        +cancelReservation() void\n        +recordPayment(payment: Payment) void\n    }\n\n    class BookingStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        PENDING\n        ACCEPTED\n        REJECTED\n        CONFIRMED\n        CANCELLED\n    }\n\n    class PaymentStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        UNPAID\n        PARTIALLY_PAID\n        PAID\n        REFUNDED\n    }\n\n    class Payment {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -Double amount\n        -LocalDateTime paymentDate\n        -String transactionRef\n        -String paymentMethod\n        -PaymentStatus status\n        +processTransaction() boolean\n        +generateReceipt() String\n    }\n\n    class Venue {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String venueName\n        -String location\n        -Integer capacity\n        -Double pricePerHour\n        -boolean isAvailable\n        +checkSlotAvailability(date: LocalDate) boolean\n        +lockSlot(date: LocalDate) void\n    }\n\n    class ServiceOffering {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String serviceName\n        -String serviceType\n        -Double rate\n        -boolean activeStatus\n        +checkAvailability(date: LocalDate) boolean\n    }\n\n    Booking --&gt; BookingStatus : tracks\n    Booking --&gt; PaymentStatus : reflects\n    Booking \&quot;1\&quot; o-- \&quot;1..*\&quot; Payment : contains\n    Event \&quot;1\&quot; *-- \&quot;0..*\&quot; Booking : aggregates\n    VendorProfile \&quot;1\&quot; *-- \&quot;1..*\&quot; ServiceOffering : offers\n    ServiceOffering \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; Booking : books service\n    Venue \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; Booking : books venue\n\n    %% =========================================================================\n    %% 4. FR4: SCHEDULE, MILESTONES &amp; TASK MANAGEMENT\n    %% =========================================================================\n    class Schedule {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -LocalDate scheduleDate\n        -boolean isPublic\n        +addMilestone(m: Milestone) void\n        +detectTimelineConflicts() List~String~\n    }\n\n    class Milestone {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String title\n        -String description\n        -LocalDate targetDate\n        -MilestoneStatus status\n        -LocalDateTime createdAt\n        +updateMilestoneProgress(status: MilestoneStatus) void\n    }\n\n    class MilestoneStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        PENDING\n        IN_PROGRESS\n        ACHIEVED\n        DELAYED\n    }\n\n    class Task {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String title\n        -String description\n        -TaskStatus status\n        -String assignedTo\n        -LocalDateTime dueDate\n        -LocalDateTime createdAt\n        +assignToStaff(staffName: String) void\n        +updateStatus(status: TaskStatus) void\n        +checkDeadlinePassed() boolean\n    }\n\n    class TaskStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        PENDING\n        IN_PROGRESS\n        COMPLETED\n        BLOCKED\n    }\n\n    Event \&quot;1\&quot; *-- \&quot;1\&quot; Schedule : contains\n    Schedule \&quot;1\&quot; *-- \&quot;0..*\&quot; Milestone : includes\n    Milestone \&quot;1\&quot; *-- \&quot;0..*\&quot; Task : groups\n    Schedule \&quot;1\&quot; *-- \&quot;0..*\&quot; Task : schedules\n    EventManager \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Task : assigns\n    InventoryStaff \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; Task : assigned to\n    Milestone --&gt; MilestoneStatus : tracks\n    Task --&gt; TaskStatus : tracks\n\n    %% =========================================================================\n    %% 5. FR5: INVENTORY &amp; ASSET MANAGEMENT\n    %% =========================================================================\n    class InventoryItem {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String sku\n        -String name\n        -String category\n        -Integer totalQuantity\n        -Integer allocatedQuantity\n        -Integer minSafetyLimit\n        -String conditionStatus\n        -BigDecimal unitCost\n        +getAvailableQuantity() int\n        +allocate(qty: int) boolean\n        +release(qty: int) void\n        +isLowStock() boolean\n    }\n\n    class Category {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String name\n        -String description\n        +addCategoryItem(item: InventoryItem) void\n    }\n\n    class EquipmentAllocation {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -Integer quantityAllocated\n        -LocalDateTime allocationDate\n        -LocalDateTime returnDate\n        -String returnedCondition\n        -String status\n        +recordReturn(condition: String, damagedQty: int) void\n    }\n\n    Category \&quot;1\&quot; *-- \&quot;0..*\&quot; InventoryItem : classifies\n    Event \&quot;1\&quot; *-- \&quot;0..*\&quot; EquipmentAllocation : allocates gear to\n    InventoryItem \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; EquipmentAllocation : reserves units of\n    InventoryStaff \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EquipmentAllocation : manages\n\n    %% =========================================================================\n    %% 6. FR1: INQUIRY, FEEDBACK &amp; RATING MANAGEMENT\n    %% =========================================================================\n    class Inquiry {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String subject\n        -String message\n        -String response\n        -InquiryStatus status\n        -LocalDateTime createdAt\n        +sendReply(replyText: String) void\n        +markAsResolved() void\n    }\n\n    class InquiryStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        OPEN\n        IN_PROGRESS\n        ANSWERED\n        CLOSED\n    }\n\n    class Review {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -Integer ratingScore\n        -String comment\n        -LocalDateTime reviewDate\n        +validateScore() boolean\n    }\n\n    Inquiry --&gt; InquiryStatus : tracks\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Inquiry : submits\n    EventManager \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Inquiry : responds to\n    VendorProfile \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Inquiry : receives / answers\n    Review \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Event : reviews\n    Review \&quot;0..*\&quot; --&gt; \&quot;1\&quot; VendorProfile : rates\n    Customer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Review : authors\n\n    %% =========================================================================\n    %% 7. FR6: PROMOTION &amp; ADVERTISEMENT MANAGEMENT\n    %% =========================================================================\n    class Campaign {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String campaignTitle\n        -LocalDate startDate\n        -LocalDate endDate\n        -Double discountPercentage\n        -DiscountType discountType\n        -PromotionStatus status\n        +publishCampaign() void\n        +closeCampaign() void\n    }\n\n    class Advertisement {\n        &lt;&lt;Entity&gt;&gt;\n        -Long id\n        -String bannerUrl\n        -String targetUrl\n        -LocalDateTime publishedDate\n        -Integer impressions\n        -Integer clickCount\n        +recordImpression() void\n        +recordClick() void\n    }\n\n    class DiscountType {\n        &lt;&lt;Enumeration&gt;&gt;\n        PERCENTAGE\n        FLAT_AMOUNT\n        SEASONAL_PACKAGE\n    }\n\n    class PromotionStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        DRAFT\n        ACTIVE\n        EXPIRED\n        PAUSED\n    }\n\n    Campaign --&gt; DiscountType : specifies\n    Campaign --&gt; PromotionStatus : evaluates\n    VendorProfile \&quot;1\&quot; *-- \&quot;0..*\&quot; Campaign : creates\n    Campaign \&quot;1\&quot; *-- \&quot;1..*\&quot; Advertisement : launches\n    Payment \&quot;0..*\&quot; ..&gt; \&quot;0..1\&quot; Campaign : applies discount from&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pDjzf7LuW0n4i5T2VTRN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
