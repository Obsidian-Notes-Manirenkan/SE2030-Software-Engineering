        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;primaryTextColor&#39;: &#39;#000000&#39;,\n    &#39;edgeLabelBackground&#39;: &#39;#FFFFFF&#39;,\n    &#39;tertiaryColor&#39;: &#39;#FFFFFF&#39;,\n    &#39;lineColor&#39;: &#39;#222222&#39;\n  }\n}}%%\nflowchart TD\n\n    %% ==========================================\n    %% External Entities (Orange Rectangles)\n    %% ==========================================\n    Customer[\&quot;Customer\&quot;]\n    Warehouse[\&quot;Warehouse\&quot;]\n    SalesDept[\&quot;Sales&lt;br/&gt;Department\&quot;]\n    PurchasingDept[\&quot;Purchasing&lt;br/&gt;Department\&quot;]\n    Supplier[\&quot;Supplier\&quot;]\n    FinanceDept[\&quot;Finance&lt;br/&gt;Department\&quot;]\n    Management[\&quot;Management\&quot;]\n\n    %% ==========================================\n    %% DFD Processes (Blue Circles)\n    %% ==========================================\n    P1((\&quot;1.0&lt;br/&gt;Manage&lt;br/&gt;Customers\&quot;))\n    P2((\&quot;2.0&lt;br/&gt;Manage&lt;br/&gt;Sales\&quot;))\n    P3((\&quot;3.0&lt;br/&gt;Manage&lt;br/&gt;Inventory\&quot;))\n    P4((\&quot;4.0&lt;br/&gt;Manage&lt;br/&gt;Purchasing\&quot;))\n    P5((\&quot;5.0&lt;br/&gt;Manage&lt;br/&gt;Finance\&quot;))\n    P6((\&quot;6.0&lt;br/&gt;Generate Mgmt&lt;br/&gt;Reports\&quot;))\n\n    %% ==========================================\n    %% Data Stores (Green Open-ended / Subroutine Boxes)\n    %% ==========================================\n    D1[[\&quot;D1&lt;br/&gt;Customer DB\&quot;]]\n    D2[[\&quot;D2&lt;br/&gt;Inventory DB\&quot;]]\n    D3[[\&quot;D3&lt;br/&gt;Supplier DB\&quot;]]\n    D4[[\&quot;D4&lt;br/&gt;Sales DB\&quot;]]\n    D5[[\&quot;D5&lt;br/&gt;Purchasing DB\&quot;]]\n    D6[[\&quot;D6&lt;br/&gt;Finance DB\&quot;]]\n\n    %% ==========================================\n    %% Process 1.0 (Manage Customers) Connections\n    %% ==========================================\n    Customer --&gt;|\&quot;Customer info,&lt;br/&gt;registration\&quot;| P1\n    P1 &lt;--&gt;|\&quot;Customer records\&quot;| D1\n    P2 &lt;--&gt;|\&quot;Customer details /&lt;br/&gt;order history\&quot;| P1\n    SalesDept --&gt;|\&quot;Customer info\&quot;| P1\n    P1 --&gt;|\&quot;Customer history\&quot;| SalesDept\n\n    %% ==========================================\n    %% Process 2.0 (Manage Sales) Connections\n    %% ==========================================\n    Customer --&gt;|\&quot;Product inquiry,&lt;br/&gt;sales order\&quot;| P2\n    P2 --&gt;|\&quot;Quotations, invoices,&lt;br/&gt;order status\&quot;| Customer\n    P2 --&gt;|\&quot;Delivery instructions\&quot;| Warehouse\n    P2 --&gt;|\&quot;Sales orders (stock check)\&quot;| P3\n    P2 --&gt;|\&quot;Quotations,&lt;br/&gt;sales orders\&quot;| SalesDept\n    SalesDept --&gt;|\&quot;Quotations, sales orders\&quot;| P2\n    SalesDept --&gt;|\&quot;Order status\&quot;| P2\n    P2 --&gt;|\&quot;Sales invoices\&quot;| P5\n    P2 --&gt; D4\n\n    %% ==========================================\n    %% Process 3.0 (Manage Inventory) Connections\n    %% ==========================================\n    P3 --&gt;|\&quot;Stock requirements,&lt;br/&gt;product info\&quot;| Warehouse\n    Warehouse --&gt;|\&quot;Goods received, goods&lt;br/&gt;issued, stock adjustments\&quot;| P3\n    P3 --&gt;|\&quot;Low-stock alerts /&lt;br/&gt;purchase requirements\&quot;| PurchasingDept\n    PurchasingDept --&gt;|\&quot;Furchas requisitions,&lt;br/&gt;POs, supplier info\&quot;| P3\n    P3 --&gt;|\&quot;Inventory availability\&quot;| SalesDept\n    P3 &lt;--&gt;|\&quot;Stock records\&quot;| D2\n\n    %% ==========================================\n    %% Process 4.0 (Manage Purchasing) Connections\n    %% ==========================================\n    P4 --&gt;|\&quot;Purchase orders,&lt;br/&gt;product requirements\&quot;| Supplier\n    Supplier --&gt;|\&quot;Product availability,&lt;br/&gt;supplier info,&lt;br/&gt;delivery info\&quot;| P4\n    PurchasingDept --&gt;|\&quot;Purchase requisitions,&lt;br/&gt;POs, supplier info\&quot;| P4\n    P4 --&gt;|\&quot;Supplier info\&quot;| PurchasingDept\n    P4 --&gt;|\&quot;Purchase receipts\&quot;| D2\n    P4 --&gt;|\&quot;Purchase invoices\&quot;| P5\n    P4 &lt;--&gt;|\&quot;Supplier records\&quot;| D3\n    P4 --&gt;|\&quot;Purchase requisitions/orders\&quot;| D5\n\n    %% ==========================================\n    %% Process 5.0 (Manage Finance) Connections\n    %% ==========================================\n    FinanceDept --&gt;|\&quot;Receivables, payables,&lt;br/&gt;invoice records\&quot;| P5\n    FinanceDept --&gt;|\&quot;Payment records,&lt;br/&gt;financial transactions\&quot;| P5\n    FinanceDept --&gt;|\&quot;Payment information\&quot;| D1\n    P5 &lt;--&gt;|\&quot;Financial records\&quot;| D6\n\n    %% ==========================================\n    %% Process 6.0 (Generate Mgmt Reports) Connections\n    %% ==========================================\n    D1 --&gt;|\&quot;Customer data\&quot;| P6\n    D4 --&gt;|\&quot;Sales data\&quot;| P6\n    D2 --&gt;|\&quot;Inventory data\&quot;| P6\n    D3 --&gt;|\&quot;Supplier data\&quot;| P6\n    D5 --&gt;|\&quot;Purchasing data\&quot;| P6\n    D6 --&gt;|\&quot;Finance data\&quot;| P6\n    P6 --&gt;|\&quot;Sales, inventory, purchasing,&lt;br/&gt;financial reports &amp; dashboards\&quot;| Management\n\n    %% ==========================================\n    %% Style Classes matching the diagram\n    %% ==========================================\n    classDef entityStyle fill:#FDE2D2,stroke:#D97746,stroke-width:1.5px,color:#1A1A1A;\n    classDef processStyle fill:#D4E8FE,stroke:#2563EB,stroke-width:2px,color:#0B2356;\n    classDef storeStyle fill:#DCFCE7,stroke:#16A34A,stroke-width:1.5px,color:#14532D;\n\n    class Customer,Warehouse,SalesDept,PurchasingDept,Supplier,FinanceDept,Management entityStyle;\n    class P1,P2,P3,P4,P5,P6 processStyle;\n    class D1,D2,D3,D4,D5,D6 storeStyle;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rmXPgqmvLAi3H3hQ0nPZ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
