        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Node Definitions\n    Customer[\&quot;Customer\&quot;]\n    Supplier[\&quot;Supplier\&quot;]\n    Management[\&quot;Management\&quot;]\n    Sales[\&quot;Sales Department\&quot;]\n    Finance[\&quot;Finance&lt;br/&gt;Department\&quot;]\n    Warehouse[\&quot;Warehouse\&quot;]\n    Purchasing[\&quot;Purchasing&lt;br/&gt;Department\&quot;]\n\n    ERP((\&quot;0&lt;br/&gt;Monara&lt;br/&gt;Intergrated ERP&lt;br/&gt;System\&quot;))\n\n    %% Customer Flows\n    Customer --&gt;|\&quot;Customer info, product inquiry,&lt;br/&gt;purchase order, payment info\&quot;| ERP\n    ERP --&gt;|\&quot;Quotations, order confirmations,&lt;br/&gt;invoices, order status\&quot;| Customer\n\n    %% Supplier Flows\n    ERP --&gt;|\&quot;Purchase orders, Product requirements\&quot;| Supplier\n    Supplier --&gt;|\&quot;Product availability, Supplier info,&lt;br/&gt;Order confirmation, delivery info\&quot;| ERP\n\n    %% Sales Department Flows\n    ERP --&gt;|\&quot;Customer history, inventory&lt;br/&gt;availability, order status\&quot;| Sales\n    Sales --&gt;|\&quot;Customer info, quotations, sales order\&quot;| ERP\n\n    %% Purchasing Department Flows\n    ERP --&gt;|\&quot;Low-stock alerts, purchase orders, supplier info\&quot;| Purchasing\n    Purchasing --&gt;|\&quot;Purchase requisitions, purchase orders, supplier onfo\&quot;| ERP\n\n    %% Warehouse Flows\n    ERP --&gt;|\&quot;Delivery instructions, stock requirements, product info\&quot;| Warehouse\n    Warehouse --&gt;|\&quot;Goods received, goods issued, stock adjustments\&quot;| ERP\n\n    %% Finance Department Flows\n    Finance --&gt;|\&quot;Payment records, financial transactions\&quot;| ERP\n    ERP --&gt;|\&quot;Sales invoice, purchase invoices, receivables, payables\&quot;| Finance\n\n    %% Management Flow\n    ERP --&gt;|\&quot;Sales, inventory, purchasing, financial &amp;&lt;br/&gt;customer reports, dashboards\&quot;| Management\n\n    %% Styling to match original diagram\n    classDef externalEntity fill:#F4E5DF,stroke:#CDBDB5,stroke-width:1.5px,color:#1C1917;\n    classDef systemProcess fill:#9FBDDB,stroke:#4B6B94,stroke-width:1.5px,color:#0F172A;\n\n    class Customer,Supplier,Management,Sales,Finance,Warehouse,Purchasing externalEntity;\n    class ERP systemProcess;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IWGKMVVwFIF_DG1HCFPv-1">
